CM_ BO_ 1760 "Event-driven VCU-to-AMI CAN firmware update protocol. Classic CAN, 11-bit identifier, DLC 8, 500 kbit/s.";
CM_ SG_ 1760 RxOpcode "For data frames, bit 7 is 1 and bits 6..0 are the sequence number modulo 128.";
CM_ SG_ 1760 EnterKey0 "Must be ASCII B (0x42).";
CM_ SG_ 1760 EnterKey1 "Must be ASCII O (0x4F).";
CM_ SG_ 1760 EnterKey2 "Must be ASCII O (0x4F).";
CM_ SG_ 1760 EnterKey3 "Must be ASCII T (0x54).";
CM_ SG_ 1760 EnterKey4 "Must be ASCII ! (0x21).";
CM_ SG_ 1760 EnterKey5 "Must be 0xA5.";
CM_ SG_ 1760 StartTarget "Only value 1 is valid and selects the fixed main/ota_0 partition.";
CM_ SG_ 1760 EndImageCRC32 "CRC-32/ISO-HDLC over exactly StartImageSize firmware bytes. Padding in the final CAN frame is excluded.";
CM_ SG_ 1760 ActivateKey "Little-endian byte sequence A5 5A C3 3C; numeric value 0x3CC35AA5.";
CM_ SG_ 1760 DataByte1 "First payload byte. DataByte1..DataByte7 are valid for every RxOpcode in range 0x80..0xFF.";

CM_ BO_ 1761 "Event-driven AMI/Recovery response for CAN firmware update.";
CM_ SG_ 1761 ErrorReceivedSize "Byte offset reached when the error was generated.";

VAL_ 1760 RxOpcode 1 "ENTER_RECOVERY" 16 "START" 17 "END_VERIFY" 18 "ACTIVATE" 19 "ABORT" 20 "QUERY" ;
VAL_ 1760 StartTarget 1 "MAIN_OTA_0" ;

VAL_ 1761 TxOpcode 129 "ENTER_ACK" 144 "RECOVERY_READY" 145 "START_ACK" 146 "DATA_ACK" 147 "VERIFY_ACK" 148 "STATUS" 149 "ACTIVATE_ACK" 150 "ABORT_ACK" 255 "ERROR" ;
VAL_ 1761 EnterAckStatus 0 "OK" 1 "INVALID_COMMAND" 2 "SESSION" 3 "LENGTH" 4 "SEQUENCE" 5 "FLASH" 6 "CRC" 7 "INVALID_IMAGE" 9 "UNSAFE_STATE" 10 "TIMEOUT" 11 "BUSY" ;
VAL_ 1761 ReadyStatus 0 "OK" 1 "INVALID_COMMAND" 2 "SESSION" 3 "LENGTH" 4 "SEQUENCE" 5 "FLASH" 6 "CRC" 7 "INVALID_IMAGE" 9 "UNSAFE_STATE" 10 "TIMEOUT" 11 "BUSY" ;
VAL_ 1761 StartAckStatus 0 "OK" 1 "INVALID_COMMAND" 2 "SESSION" 3 "LENGTH" 4 "SEQUENCE" 5 "FLASH" 6 "CRC" 7 "INVALID_IMAGE" 9 "UNSAFE_STATE" 10 "TIMEOUT" 11 "BUSY" ;
VAL_ 1761 DataAckStatus 0 "OK" 1 "INVALID_COMMAND" 2 "SESSION" 3 "LENGTH" 4 "SEQUENCE" 5 "FLASH" 6 "CRC" 7 "INVALID_IMAGE" 9 "UNSAFE_STATE" 10 "TIMEOUT" 11 "BUSY" ;
VAL_ 1761 VerifyStatus 0 "OK" 1 "INVALID_COMMAND" 2 "SESSION" 3 "LENGTH" 4 "SEQUENCE" 5 "FLASH" 6 "CRC" 7 "INVALID_IMAGE" 9 "UNSAFE_STATE" 10 "TIMEOUT" 11 "BUSY" ;
VAL_ 1761 ActivateAckStatus 0 "OK" 1 "INVALID_COMMAND" 2 "SESSION" 3 "LENGTH" 4 "SEQUENCE" 5 "FLASH" 6 "CRC" 7 "INVALID_IMAGE" 9 "UNSAFE_STATE" 10 "TIMEOUT" 11 "BUSY" ;
VAL_ 1761 AbortAckStatus 0 "OK" 1 "INVALID_COMMAND" 2 "SESSION" 3 "LENGTH" 4 "SEQUENCE" 5 "FLASH" 6 "CRC" 7 "INVALID_IMAGE" 9 "UNSAFE_STATE" 10 "TIMEOUT" 11 "BUSY" ;
VAL_ 1761 ErrorCode 0 "OK" 1 "INVALID_COMMAND" 2 "SESSION" 3 "LENGTH" 4 "SEQUENCE" 5 "FLASH" 6 "CRC" 7 "INVALID_IMAGE" 9 "UNSAFE_STATE" 10 "TIMEOUT" 11 "BUSY" ;
VAL_ 1761 VerifyState 0 "IDLE" 1 "RECEIVING" 2 "VERIFIED" ;
VAL_ 1761 StatusUpdateState 0 "IDLE" 1 "RECEIVING" 2 "VERIFIED" ;

BA_DEF_ BO_ "GenMsgCycleTime" INT 0 65535;
BA_DEF_DEF_ "GenMsgCycleTime" 0;
BA_ "GenMsgCycleTime" BO_ 1760 0;
BA_ "GenMsgCycleTime" BO_ 1761 0;

SG_MUL_VAL_ 1760 DataByte1 RxOpcode 128-255;
SG_MUL_VAL_ 1760 DataByte2 RxOpcode 128-255;
SG_MUL_VAL_ 1760 DataByte3 RxOpcode 128-255;
SG_MUL_VAL_ 1760 DataByte4 RxOpcode 128-255;
